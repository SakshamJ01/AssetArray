{
  "expo": {
    "name": "Asset Array",
    "slug": "asset-array",
    "version": "1.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050914"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assetarray.app"
    },
    "android": {
      "package": "com.assetarray.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050914"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "839dd4ea-2b98-44ce-8f27-cd23f6bb0b96"
      }
    }
  }
}
