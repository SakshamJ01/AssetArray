{
  "expo": {
    "name": "Asset Array",
    "slug": "asset-array",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assetarray.app"
    },

"android": {
  "package": "com.assetarray.app",
  "usesCleartextTraffic": true,
  "adaptiveIcon": {
    "backgroundColor": "#102033"
  }
},


    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "839dd4ea-2b98-44ce-8f27-cd23f6bb0b96"
      }
    }
  }
}
