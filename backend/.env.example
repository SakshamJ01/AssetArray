PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=asset_array

# Set to true in production.
AUTH_REQUIRED=false

# Use strong secrets in production.
TOKEN_SECRET=replace-with-long-random-secret
REFRESH_SECRET=replace-with-long-random-refresh-secret

# Admin identity: server-side only. Never put ADMIN_PASSWORD in frontend code
# or EXPO_PUBLIC_* variables. Production must use a strong unique value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Security controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_MAX_FAILURES=5
AUTH_LOCK_WINDOW_MS=900000

# CORS
CORS_ORIGIN=*

# Gemini AI research
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
# Override for the DEEP_RESEARCH task model. Default gemini-2.5-pro is retired
# for new accounts (404) and gemini-3.1-pro-preview requires billing; if your
# account only has free-tier flash access, set it to a flash model.
AI_GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# Ollama local AI daemon
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
