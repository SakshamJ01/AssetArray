PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=asset_array

# Set to true in production.
AUTH_REQUIRED=false

# Use strong secrets in production.
TOKEN_SECRET=replace-with-long-random-secret
REFRESH_SECRET=replace-with-long-random-refresh-secret

# Seed admin account on first boot (when auth-store.json does not exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!

# Token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Security controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# CORS
CORS_ORIGIN=*

# Gemini AI research
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
